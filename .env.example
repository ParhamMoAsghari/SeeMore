# =====================================================================================================
# seemore configuration. Copy to .env and protect it:   cp .env.example .env && chmod 600 .env
# Used by docker compose (variable substitution) and passed to the seemore, subfa and caddy containers.
# Never commit the real .env. Values you later change in the panel (Settings) are stored in SQLite and take
# precedence over the defaults below; secrets (tokens, keys, passwords) are only ever read from this file.
# =====================================================================================================

# ----------------------------------------------------------------------------- compose / host layout
# Which optional parts to run: media (Jellyfin + *arr + qBittorrent + Bazarr + FlareSolverr), subfa, proxy (Caddy).
# Remove a profile if you already run that service elsewhere and point the *_URL variables below at it.
COMPOSE_PROFILES=media,subfa,proxy
# Extra compose files, ':'-separated. Region workarounds: docker-compose.yml:compose/iran.yml (docs/iran.md)
#COMPOSE_FILE=docker-compose.yml
COMPOSE_PROJECT_NAME=seemore
# Docker network shared by all services (created by `make bootstrap`)
SEEMORE_NETWORK=seemore
# Timezone of every container (the bot/panel show Jalali dates; Asia/Tehran is typical for Persian users)
TZ=UTC
# uid/gid that owns the media files and runs the containers
SEEMORE_UID=1000
SEEMORE_GID=1000
# Host path of the media/data disk, mounted as /data in the containers. Expected layout:
#   /data/media/movies  /data/media/tv  /data/torrents  (seemore adds /data/usb-imports, /data/backups/seemore)
SEEMORE_DATA=/data
# Where the seemore DB, subfa state and Caddy data live on the host (relative to this folder or absolute)
SEEMORE_STATE_DIR=./state
# Config folders of Jellyfin, Radarr, Sonarr, ... (profile media)
SEEMORE_APPDATA=./appdata
# Host mount base of USB drives and the runtime dirs of the host helpers (must match host/install.sh)
SEEMORE_USB_ROOT=/media/usb
SEEMORE_USBCTL=/run/usb-automount
SEEMORE_CTL=/run/seemore-ctl
DOCKER_SOCKET=/var/run/docker.sock

# ----------------------------------------------------------------------------- seemore container
SEEMORE_IMAGE=seemore:local
SEEMORE_CONTAINER=seemore
# Memory limit; also settable in the panel (container.mem_limit, applied by recreating the container)
SEEMORE_MEM_LIMIT=512m
# Optional direct host binding of the panel (loopback or private IP only; public access goes through Caddy)
SEEMORE_PANEL_BIND=127.0.0.1:8098
# Ports inside the container (panel: net.api_port / net.links_port). 3000 (webhooks/RPC) is fixed.
API_PORT=3002
DL_PORT=3001
# Image build args (see Dockerfile; mirrors are useful where Docker Hub / Alpine / npm are filtered)
NODE_IMAGE=node:22-alpine
ALPINE_MIRROR=
NPM_REGISTRY=
# 1 = download RARLAB rar into the image (needed only for RAR share links)
WITH_RAR=1

# ----------------------------------------------------------------------------- bot (messenger)
# telegram (default) or bale. Panel: bot.messenger
MESSENGER=telegram
# Name of the variable below that holds the token. Panel: bot.token_env
BOT_TOKEN_ENV=TELEGRAM_TOKEN
# Bot token from @BotFather (Telegram) — SECRET
TELEGRAM_TOKEN=
# Bot token for Bale (only with MESSENGER=bale, BOT_TOKEN_ENV=BALE_TOKEN) — SECRET
BALE_TOKEN=
# Numeric user id of the owner. The bot answers only the owner and users the owner grants access to.
ALLOWED_CHAT=
# polling (works behind NAT, default) or webhook (Telegram only). Panel: bot.update_mode
BOT_UPDATE_MODE=polling
# Webhook mode: public HTTPS URL Telegram posts to; proxy it to seemore:BOT_WEBHOOK_PORT (see docs/bot-telegram.md)
BOT_WEBHOOK_URL=
BOT_WEBHOOK_PORT=3003
# Webhook secret checked on every update (random string; derived from the token when empty) — SECRET
BOT_WEBHOOK_SECRET=
# Optional Bot API base URL (a local telegram-bot-api server or a reverse proxy, e.g. where Telegram is filtered)
#TELEGRAM_API_BASE=https://api.telegram.org
#BALE_API_BASE=https://tapi.bale.ai

# ----------------------------------------------------------------------------- panel / API
# Panel login of the owner; the password is the value of the variable named by PANEL_OWNER_PASS_ENV
# (by default the shared system password JELLYFIN_PASS, so one password works everywhere)
PANEL_OWNER_USER=admin
PANEL_OWNER_PASS_ENV=JELLYFIN_PASS
# Random strings (e.g. `openssl rand -hex 24`) — SECRET
# HOOK_KEY: path secret of the Radarr/Sonarr webhook (http://seemore:3000/hook/<HOOK_KEY>)
HOOK_KEY=
# INTERNAL_API_KEY: internal RPC / event stream on :3000 (docker network only)
INTERNAL_API_KEY=

# ----------------------------------------------------------------------------- domains (Caddy)
# Defaults for a fresh install; change them later in the panel (Settings → Domains). Empty = disabled.
PANEL_PUBLIC_HOST=panel.example.com
PANEL_LAN_HOST=
DL_PUBLIC_HOST=dl.example.com
DL_LAN_HOST=
# Base URLs printed in share links (public and LAN)
DL_PUBLIC=https://dl.example.com
DL_LAN=
# ACME account e-mail for Let's Encrypt (used by config/Caddyfile)
ACME_EMAIL=admin@example.com
CADDY_IMAGE=caddy:2-alpine
CADDY_CONTAINER=caddy
CADDYFILE=./config/Caddyfile
HTTP_PORT=80
HTTPS_PORT=443

# ----------------------------------------------------------------------------- media services
# Inside the docker network the defaults just work; change them if a service runs elsewhere.
RADARR_URL=http://radarr:7878
SONARR_URL=http://sonarr:8989
PROWLARR_URL=http://prowlarr:9696
BAZARR_URL=http://bazarr:6767
QBIT_URL=http://qbittorrent:8080
JELLYFIN_API=http://jellyfin:8096
# API keys (Settings → General in each app) — SECRET
RADARR_KEY=
SONARR_KEY=
PROWLARR_KEY=
BAZARR_KEY=
# qBittorrent Web UI login — SECRET
QBIT_USER=admin
QBIT_PASS=
# Jellyfin URL shown in bot cards / panel links (panel: jellyfin.public_url)
JELLYFIN_URL=https://jellyfin.example.com
# Jellyfin account used for library refreshes; JELLYFIN_PASS doubles as the panel owner password — SECRET
JELLYFIN_USER=admin
JELLYFIN_PASS=
# Root folders for new requests (empty = the first Radarr/Sonarr root folder under /data/media)
MOVIES_ROOT=/data/media/movies
TV_ROOT=/data/media/tv
# Display name for SEEMORE_UID in file metadata
PUSER=user
# Where daily DB backups go (inside the container; /data is SEEMORE_DATA)
BACKUP_DIR=/data/backups/seemore
# Containers the panel may restart / read logs of (comma list)
CTL_RESTARTABLE=seemore,subfa,bazarr,qbittorrent,radarr,sonarr,prowlarr,jellyfin,flaresolverr,jellyseerr,caddy
# Host-side bind addresses/ports of the service UIs (admin UIs stay on 127.0.0.1; reach them via Caddy or SSH tunnel)
JELLYFIN_BIND=127.0.0.1
JELLYFIN_PORT=8096
SEERR_BIND=127.0.0.1
SEERR_PORT=5055
RADARR_PORT=7878
SONARR_PORT=8989
PROWLARR_PORT=9696
BAZARR_PORT=6767
QBIT_WEBUI_PORT=8080
FLARESOLVERR_PORT=8191
TORRENT_PORT=6881
# Image overrides (pin versions or use a mirror)
#JELLYFIN_IMAGE=lscr.io/linuxserver/jellyfin:latest
#SEERR_IMAGE=ghcr.io/seerr-team/seerr:latest
#RADARR_IMAGE=lscr.io/linuxserver/radarr:latest
#SONARR_IMAGE=lscr.io/linuxserver/sonarr:latest
#PROWLARR_IMAGE=lscr.io/linuxserver/prowlarr:latest
#QBIT_IMAGE=lscr.io/linuxserver/qbittorrent:latest
#BAZARR_IMAGE=lscr.io/linuxserver/bazarr:latest
#FLARESOLVERR_IMAGE=ghcr.io/flaresolverr/flaresolverr:latest
#SOCKET_PROXY_IMAGE=lscr.io/linuxserver/socket-proxy:latest

# ----------------------------------------------------------------------------- subfa (Persian subtitles)
# Shared secret of subfa's own import webhook (Radarr/Sonarr → http://subfa:8090/hook/<SUBFA_HOOK_KEY>) — SECRET
SUBFA_HOOK_KEY=
# Defaults; tunable at runtime in the panel (Settings → subfa)
SUBFA_POLL_SECONDS=180
SUBFA_SWEEP_SECONDS=21600
SUBFA_BAZARR_GRACE=900
SUBFA_BACKOFF_HOURS=6,12
SUBFA_SUBF2M_GAP=8
SUBFA_NOTIFY=1
#SUBF2M_URL=https://subf2m.co
#SUBFA_IMAGE=lscr.io/linuxserver/bazarr:latest
