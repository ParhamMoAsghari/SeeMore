#!/usr/bin/env python3
"""seemore-ctl: tiny root helper on the Docker host for the few actions the seemore container may not do itself.

The container drops JSON requests into /run/seemore-ctl/requests/<id>.json; a systemd path unit starts this
script, which executes ONLY actions allowed by /etc/seemore/ctl.conf and writes /run/seemore-ctl/results/<id>.json.

Actions
  recreate      update allow-listed KEY=VALUE lines in <compose dir>/.env (validated per key), then
                `docker compose up -d --force-recreate <service>`; on failure the previous .env is restored and the
                service is brought up again with it. Optional args.then = "caddy-reload".
  caddy-reload  `caddy validate` then `caddy reload` inside the Caddy container (graceful, no downtime).
Nothing else (no shell, no arbitrary commands, no paths from the request)."""
import json, os, re, shutil, subprocess, sys, time

CONF = os.environ.get('SEEMORE_CTL_CONF', '/etc/seemore/ctl.conf')
BASE = os.environ.get('SEEMORE_CTL_DIR', '/run/seemore-ctl')
REQ, RES = os.path.join(BASE, 'requests'), os.path.join(BASE, 'results')
ID_RE = re.compile(r'^[a-z0-9]{6,16}-[a-f0-9]{8}$')
PRIVATE_BIND = r'^((127\.\d{1,3}\.\d{1,3}\.\d{1,3})|(10\.\d{1,3}\.\d{1,3}\.\d{1,3})|(192\.168\.\d{1,3}\.\d{1,3})|(172\.(1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3})):\d{2,5}$'
DEFAULT_VALIDATORS = {'port': r'^([1-9]\d{3}|[1-5]\d{4}|6[0-4]\d{3}|65[0-4]\d\d|655[0-2]\d|6553[0-5])$', 'mem': r'^\d{2,6}[mMgG]$', 'private_bind': PRIVATE_BIND + '|^$'}

def log(*a): print(time.strftime('%F %T'), *a, flush=True)
def run(cmd, cwd=None, timeout=300):
    p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout)
    return p.returncode, (p.stdout + p.stderr)[-1500:]

def caddy_reload(conf):
    c = conf['caddy']; cfg = c.get('config', '/etc/caddy/Caddyfile')
    rc, out = run(['docker', 'exec', c['container'], 'caddy', 'validate', '--config', cfg, '--adapter', 'caddyfile'], timeout=120)
    if rc != 0: return {'ok': False, 'error': 'caddy validate failed', 'out': out}
    rc, out2 = run(['docker', 'exec', c['container'], 'caddy', 'reload', '--config', cfg, '--adapter', 'caddyfile'], timeout=120)
    if rc != 0: return {'ok': False, 'error': 'caddy reload failed', 'out': out2}
    return {'ok': True}

def set_env(path, changes):
    lines = open(path).read().splitlines() if os.path.exists(path) else []
    seen = set(); out = []
    for l in lines:
        m = re.match(r'^([A-Z0-9_]+)=', l)
        if m and m.group(1) in changes:
            seen.add(m.group(1)); v = changes[m.group(1)]
            if v is not None: out.append(f'{m.group(1)}={v}')
            continue
        out.append(l)
    for k, v in changes.items():
        if k not in seen and v is not None: out.append(f'{k}={v}')
    st = os.stat(path) if os.path.exists(path) else None
    tmp = path + '.seemore-tmp'
    with open(tmp, 'w') as f: f.write('\n'.join(out) + '\n'); f.flush(); os.fsync(f.fileno())
    if st: os.chown(tmp, st.st_uid, st.st_gid); os.chmod(tmp, st.st_mode & 0o777)
    else: os.chmod(tmp, 0o600)
    os.replace(tmp, path)

def recreate(conf, target, args):
    svc = conf.get('compose', {}).get(target)
    if not svc: return {'ok': False, 'error': f'target {target} not allowed'}
    env = args.get('env') or {}
    if not isinstance(env, dict): return {'ok': False, 'error': 'bad env'}
    allowed = svc.get('env', {}); vals = {**DEFAULT_VALIDATORS, **conf.get('validators', {})}
    for k, v in env.items():
        if k not in allowed: return {'ok': False, 'error': f'env key {k} not allowed'}
        if not isinstance(v, str) or not re.match(vals[allowed[k]], v): return {'ok': False, 'error': f'invalid value for {k}'}
    d = svc['dir']; envf = os.path.join(d, '.env')
    bdir = os.path.join(d, 'backups', 'ctl'); os.makedirs(bdir, exist_ok=True)
    bak = os.path.join(bdir, f'.env.{time.strftime("%Y%m%d-%H%M%S")}')
    if os.path.exists(envf): shutil.copy2(envf, bak)
    if env: set_env(envf, env)
    cmd = ['docker', 'compose', '-f', os.path.join(d, svc.get('file', 'docker-compose.yml')), 'up', '-d', '--force-recreate', svc.get('service', target)]
    rc, out = run(cmd, cwd=d, timeout=600)
    if rc != 0:
        if os.path.exists(bak): shutil.copy2(bak, envf)
        rc2, out2 = run(cmd, cwd=d, timeout=600)
        return {'ok': False, 'error': 'compose up failed; previous .env restored', 'out': out, 'restored': rc2 == 0}
    res = {'ok': True, 'env': sorted(env)}
    if args.get('then') == 'caddy-reload':
        time.sleep(3); res['caddy'] = caddy_reload(conf)
        if not res['caddy']['ok']: res['ok'] = False; res['error'] = 'recreated, but caddy reload failed'
    return res

def handle(conf, name):
    p = os.path.join(REQ, name); rid = name[:-5]
    try:
        fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW)
        with os.fdopen(fd) as f: raw = f.read(65536)
        os.unlink(p)
        r = json.loads(raw)
        if r.get('id') != rid: raise ValueError('id mismatch')
        a = r.get('action'); t = r.get('target'); args = r.get('args') or {}
        log('request', rid, a, t)
        if a == 'recreate': res = recreate(conf, t, args)
        elif a == 'caddy-reload': res = caddy_reload(conf)
        else: res = {'ok': False, 'error': f'action {a} not allowed'}
    except Exception as e:
        try: os.unlink(p)
        except OSError: pass
        res = {'ok': False, 'error': f'bad request: {e}'}
    res.update({'id': rid, 't': int(time.time() * 1000)})
    tmp = os.path.join(RES, f'.{rid}.tmp')
    with open(tmp, 'w') as f: json.dump(res, f)
    os.chmod(tmp, 0o644); os.replace(tmp, os.path.join(RES, f'{rid}.json'))
    log('result', rid, 'ok' if res.get('ok') else 'FAILED ' + str(res.get('error')))

def main():
    conf = json.load(open(CONF))
    os.makedirs(RES, exist_ok=True)
    for _ in range(3):  # pick up requests that arrive while we run
        names = sorted(n for n in os.listdir(REQ) if n.endswith('.json') and ID_RE.match(n[:-5]))
        if not names: time.sleep(1); continue
        for n in names: handle(conf, n)
    now = time.time()  # results nobody collected (older than a day)
    for n in os.listdir(RES):
        f = os.path.join(RES, n)
        if now - os.path.getmtime(f) > 86400: os.unlink(f)

if __name__ == '__main__':
    sys.exit(main())
