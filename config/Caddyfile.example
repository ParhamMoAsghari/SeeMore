# Copy to config/Caddyfile (or set CADDYFILE in .env). Caddy obtains and renews certificates automatically.
{
	email {$ACME_EMAIL:admin@example.com}
}

# Your other sites, for example:
# jellyfin.example.com {
# 	reverse_proxy jellyfin:8096
# }
# requests.example.com {
# 	reverse_proxy jellyseerr:5055
# }

# seemore panel + download links. These site blocks are generated by seemore from the panel settings
# (Settings → Domains) into state/caddy-sites/seemore.caddy, validated and reloaded without downtime.
import /etc/caddy/seemore/*.caddy
